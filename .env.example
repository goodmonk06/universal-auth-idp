# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/universal_auth_idp?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Secrets
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Magic Link
MAGIC_LINK_SECRET="your-magic-link-secret-change-this-in-production"
MAGIC_LINK_EXPIRATION="15m"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# API Configuration
API_PORT=3000
API_HOST="localhost"
API_URL="http://localhost:3000"

# Admin UI Configuration
ADMIN_PORT=3001
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Email (for magic links - configure with your email service)
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_SERVICE="smtp"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"

# Platform Admin (initial setup)
PLATFORM_ADMIN_EMAIL="admin@example.com"
PLATFORM_ADMIN_PASSWORD="change-this-password"
